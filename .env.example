ANTHROPIC_API_KEY=
# Keewano project API key (SDK type), Settings -> Project -> API Keys. Writes events.
KEEWANO_API_KEY=
# Keewano personal access token (kwpat-...), Settings -> Personal -> Security. Reads (MCP + SQL).
KEEWANO_PAT=
KEEWANO_MCP_URL=https://api.keewano.com/mcp
# For direct SQL (report + agent): your Keewano login email and project UUID (Settings -> Details -> Project ID)
KEEWANO_EMAIL=
KEEWANO_PROJECT_ID=
# Optional: override the ingest endpoint (default https://api.keewano.com/event/ingress/v1/json)
KEEWANO_INGEST_URL=
